# =====================================================================
# Variáveis de ambiente — copie para .env.local (desenvolvimento) ou
# cadastre no gerenciador de segredos da hospedagem (produção).
# NUNCA versione valores reais.
# =====================================================================

# URL pública do site, sem barra no final (usada em links de e-mail,
# retorno do Mercado Pago e URL do webhook). Em produção: https://seudominio.com.br
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Segredo das sessões (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
BETTER_AUTH_SECRET=

# Chave para criptografar segredos salvos pelo painel (ex.: Access Token do Mercado Pago).
# Mínimo 32 caracteres. Se trocar, as credenciais salvas pelo painel precisam ser cadastradas de novo.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Banco de dados PostgreSQL (Supabase, Neon, RDS...). Obrigatório em produção.
# Supabase: Project Settings → Database → Connection string (URI). Use o "pooler" em ambientes serverless.
# Sem DATABASE_URL, o desenvolvimento usa um PostgreSQL embarcado (PGlite) em ./.data/pglite
# ---------------------------------------------------------------------
DATABASE_URL=
# DATABASE_POOL_MAX=5
# PGLITE_DIR=./.data/pglite

# ---------------------------------------------------------------------
# Mercado Pago (opcional aqui — também pode ser configurado pelo painel em
# /admin/configuracoes/mercado-pago). Quando definidas, estas variáveis têm prioridade.
# ---------------------------------------------------------------------
# MP_ENVIRONMENT=test            # test | production
# MP_PUBLIC_KEY=
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=             # "Assinatura secreta" da tela de Webhooks

# ---------------------------------------------------------------------
# E-mail (opcional). Sem isso, nenhum e-mail é enviado (os avisos aparecem na área da cliente).
# Exemplo: smtps://usuario:senha@smtp.seuprovedor.com:465
# ---------------------------------------------------------------------
# SMTP_URL=
# EMAIL_FROM="Nome do Estúdio <contato@seudominio.com.br>"
# Exigir confirmação de e-mail no cadastro (só funciona com SMTP configurado)
# REQUIRE_EMAIL_VERIFICATION=1

# ---------------------------------------------------------------------
# Rotina de manutenção (/api/cron/manutencao): libera reservas vencidas e
# reconsulta pagamentos pendentes. Envie: Authorization: Bearer <CRON_SECRET>
# ---------------------------------------------------------------------
# CRON_SECRET=

# Limite de tentativas de login também em desenvolvimento (em produção já é ativo)
# AUTH_RATE_LIMIT=1
